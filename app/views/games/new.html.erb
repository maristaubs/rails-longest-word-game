<h1>New game</h1>

<div class="letters">
  <% @letters.each do |letter| %>
    <span class="letter"><%= letter %></span>
  <% end %>
</div>

<form action="/score" method="post" data-turbo="false">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= hidden_field_tag :letters, @letters.join %>
  <label for="word" class="form-label">What is the longest word you can find?</label>
  <div class="input-group">
    <input type="text" id="word" name="word" class="form-control">
    <input type="submit" value="Play" class="btn btn-outline-secondary">
  </div>
</form>
